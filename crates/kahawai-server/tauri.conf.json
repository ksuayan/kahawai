{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Kahawai Server",
        "width": 720,
        "height": 560,
        "minWidth": 720,
        "minHeight": 560
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "frontendDist": "ui/dist"
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "copyright": "Copyright (c) 2026 Kyo Suayan. Licensed under the GNU AGPL v3 or later.",
    "license": "AGPL-3.0-or-later",
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "targets": "all"
  },
  "identifier": "com.suayan.kahawai-server",
  "productName": "Kahawai Server",
  "version": "0.1.0"
}
